{
  "name": "DriverSubscriptionPlan",
  "type": "object",
  "properties": {
    "plan_code": {
      "type": "string",
      "enum": [
        "starter",
        "standard",
        "premium",
        "trial"
      ],
      "description": "Canonical plan identifier. 'trial' is the 60-day free trial plan, not selectable by drivers."
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Monthly subscription price"
    },
    "currency": {
      "type": "string",
      "default": "NAD"
    },
    "trip_allowance": {
      "type": "number",
      "default": 0,
      "description": "Maximum completed trips per subscription month. Ignored when is_unlimited is true."
    },
    "is_unlimited": {
      "type": "boolean",
      "default": false,
      "description": "True for plans with no trip cap (e.g. Premium, Trial)"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly"
      ],
      "default": "monthly"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}