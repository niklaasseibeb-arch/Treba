{
  "name": "TripOperationEvent",
  "type": "object",
  "properties": {
    "trip_operation_id": {
      "type": "string"
    },
    "allocation_id": {
      "type": "string"
    },
    "driver_user_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "passenger_check_in",
        "trip_start",
        "trip_completion",
        "passenger_no_show",
        "driver_no_show",
        "cancellation",
        "incident"
      ]
    },
    "booking_id": {
      "type": "string"
    },
    "passenger_id": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_by": {
      "type": "string"
    }
  },
  "required": [
    "trip_operation_id",
    "event_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.driver_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}