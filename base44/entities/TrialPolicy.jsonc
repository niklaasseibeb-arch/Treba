{
  "name": "TrialPolicy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "trial_duration_days": {
      "type": "number",
      "default": 60,
      "description": "Length of the driver free trial in calendar days."
    },
    "reminder_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        30,
        14,
        7,
        3,
        1
      ],
      "description": "Days-remaining thresholds at which the driver is notified."
    },
    "transition_policy": {
      "type": "string",
      "enum": [
        "honor_existing_bookings",
        "release_bookings"
      ],
      "default": "honor_existing_bookings",
      "description": "How existing confirmed bookings are handled when a trial expires."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}