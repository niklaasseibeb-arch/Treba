{
  "name": "PassengerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the authenticated Treba user"
    },

    "full_name": {
      "type": "string",
      "description": "Passenger's full name"
    },

    "phone": {
      "type": "string",
      "description": "Passenger's mobile phone number"
    },

    "email": {
      "type": "string",
      "description": "Passenger's email address"
    },

    "profile_photo_url": {
      "type": "string",
      "description": "URL of passenger profile photo"
    },

    "preferred_contact_method": {
      "type": "string",
      "description": "Passenger's preferred contact method",
      "enum": [
        "phone",
        "sms",
        "whatsapp",
        "email"
      ]
    },

    "emergency_contact_name": {
      "type": "string",
      "description": "Emergency contact name"
    },

    "emergency_contact_phone": {
      "type": "string",
      "description": "Emergency contact phone number"
    },

    "payment_methods": {
      "type": "array",
      "description": "Passenger payment methods",
      "items": {
        "type": "object"
      },
      "default": []
    },

    "trips_completed": {
      "type": "number",
      "description": "Number of completed trips",
      "default": 0
    },

    "trips_cancelled": {
      "type": "number",
      "description": "Number of cancelled trips",
      "default": 0
    },

    "no_show_count": {
      "type": "number",
      "description": "Number of passenger no-shows",
      "default": 0
    },

    "reliability_score": {
      "type": "number",
      "description": "Passenger reliability score",
      "default": 100
    },

    "account_status": {
      "type": "string",
      "description": "Passenger account status",
      "enum": [
        "active",
        "pending",
        "suspended"
      ],
      "default": "active"
    }
  },

  "required": [
    "user_id",
    "full_name",
    "phone"
  ]
}
