{
  "name": "PassengerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the User this profile belongs to"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "profile_info": {
      "type": "string",
      "description": "Optional additional profile information"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending"
      ],
      "default": "active"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "sms",
        "whatsapp",
        "phone_call",
        "email"
      ],
      "default": "sms"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "phone_verified": {
      "type": "boolean",
      "default": false
    },
    "no_show_count": {
      "type": "number",
      "default": 0
    },
    "cancellation_count": {
      "type": "number",
      "default": 0
    },
    "completed_trips_count": {
      "type": "number",
      "default": 0
    },
    "reliability_score": {
      "type": "number",
      "default": 100
    },
    "cash_no_show_count": {
      "type": "number",
      "default": 0,
      "description": "Number of cash no-shows (missed cash payment/check-in deadlines)"
    },
    "cash_restricted": {
      "type": "boolean",
      "default": false,
      "description": "If true, the passenger may not use cash payment"
    },
    "requires_digital_payment": {
      "type": "boolean",
      "default": false,
      "description": "If true, the passenger must pay digitally"
    },
    "account_review": {
      "type": "boolean",
      "default": false,
      "description": "If true, the passenger account is flagged for admin review"
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "is_default": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}