{
  "name": "PayoutTransaction",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "Reference to the DriverProfile this payout belongs to"
    },
    "driver_user_id": {
      "type": "string",
      "description": "User id of the driver, used for row-level read access"
    },
    "wallet_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "fee_amount": {
      "type": "number",
      "default": 0,
      "description": "Treba fee/charge applied to this payout"
    },
    "net_amount": {
      "type": "number",
      "description": "Amount after Treba fees"
    },
    "status": {
      "type": "string",
      "enum": [
        "earnings_pending",
        "available_for_payout",
        "payout_processing",
        "paid",
        "failed",
        "reversed"
      ],
      "default": "earnings_pending"
    },
    "provider_reference": {
      "type": "string"
    },
    "transaction_reference": {
      "type": "string",
      "description": "Gateway transaction reference returned by the payout provider"
    },
    "related_booking_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.driver_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}