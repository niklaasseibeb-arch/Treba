{
  "name": "TripRequest",
  "type": "object",

  "properties": {
    "passenger_id": {
      "type": "string"
    },

    "passenger_name": {
      "type": "string"
    },

    "route_id": {
      "type": "string"
    },

    "origin": {
      "type": "string",
      "description": "Origin town"
    },

    "destination": {
      "type": "string",
      "description": "Destination town"
    },

    "pickup_location": {
      "type": "string",
      "description": "Physical pickup location within the origin town"
    },

    "dropoff_location": {
      "type": "string",
      "description": "Physical drop-off location within the destination town"
    },

    "pickup_is_standard": {
      "type": "boolean",
      "default": false
    },

    "dropoff_is_standard": {
      "type": "boolean",
      "default": false
    },

    "requested_date": {
      "type": "string"
    },

    "requested_time": {
      "type": "string"
    },

    "time_window_minutes": {
      "type": "number",
      "default": 60
    },

    "booking_advance_days": {
      "type": "number",
      "default": 0
    },

    "number_of_seats": {
      "type": "number",
      "default": 1
    },

    "luggage_small_bags": {
      "type": "number",
      "default": 0
    },

    "luggage_standard_bags": {
      "type": "number",
      "default": 0
    },

    "luggage_large_suitcases": {
      "type": "number",
      "default": 0
    },

    "luggage_oversized_items": {
      "type": "number",
      "default": 0
    },

    "luggage_weight_category": {
      "type": "string"
    },

    "luggage_details": {
      "type": "string"
    },

    "notes": {
      "type": "string"
    },

    "request_type": {
      "type": "string",
      "enum": [
        "single",
        "group",
        "proxy",
        "recurring"
      ],
      "default": "single"
    },

    "booking_for_someone_else": {
      "type": "boolean",
      "default": false
    },

    "proxy_passenger_name": {
      "type": "string"
    },

    "proxy_passenger_phone": {
      "type": "string"
    },

    "group_name": {
      "type": "string"
    },

    "group_size": {
      "type": "number",
      "default": 1
    },

    "recurring_booking_id": {
      "type": "string"
    },

    "payment_method": {
      "type": "string",
      "enum": [
        "direct_to_driver"
      ],
      "default": "direct_to_driver"
    },

    "request_status": {
      "type": "string",
      "enum": [
        "requested",
        "matching",
        "matched",
        "offers_sent",
        "driver_selected",
        "scheduled",
        "booked",
        "completed",
        "cancelled",
        "expired",
        "no_driver"
      ],
      "default": "requested"
    },

    "matching_started_at": {
      "type": "string"
    },

    "matching_completed_at": {
      "type": "string"
    },

    "matched_at": {
      "type": "string"
    },

    "matched_allocation_id": {
      "type": "string"
    },

    "matched_driver_id": {
      "type": "string"
    },

    "matched_driver_name": {
      "type": "string"
    },

    "matched_driver_user_id": {
      "type": "string"
    },

    "matched_vehicle_id": {
      "type": "string"
    },

    "declined_driver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },

    "allocation_id": {
      "type": "string"
    },

    "booking_id": {
      "type": "string"
    }
  },

  "required": [
    "passenger_id",
    "origin",
    "destination",
    "requested_date",
    "requested_time",
    "number_of_seats",
    "request_status"
  ]
}