{
  "name": "DriverNoShowPolicy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "grace_minutes": {
      "type": "number",
      "default": 15,
      "description": "Minutes after scheduled departure the passenger must wait before reporting a driver no-show"
    },
    "dispute_window_hours": {
      "type": "number",
      "default": 48,
      "description": "Hours after a driver no-show is reported during which the driver may respond"
    },
    "refund_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether passenger protection refunds are permitted under this policy. Treba never auto-refunds."
    },
    "refund_percentage": {
      "type": "number",
      "default": 100,
      "description": "Admin-configured passenger refund percentage. Never hard-coded; set per policy."
    },
    "charge_driver": {
      "type": "boolean",
      "default": true,
      "description": "If true, the driver is penalised/forfeits the fare under this policy"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}