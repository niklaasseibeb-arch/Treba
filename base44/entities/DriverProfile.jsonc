{
  "name": "DriverProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the authenticated Treba user"
    },

    "full_name": {
      "type": "string",
      "description": "Driver's full name"
    },

    "phone": {
      "type": "string",
      "description": "Driver's mobile phone number"
    },

    "profile_photo_url": {
      "type": "string",
      "description": "URL of the driver's profile photo"
    },

    "license_number": {
      "type": "string",
      "description": "Driver licence number"
    },

    "license_expiry": {
      "type": "string",
      "description": "Driver licence expiry date"
    },

    "driving_experience_years": {
      "type": "number",
      "description": "Number of years of driving experience",
      "default": 0
    },

    "vehicle_id": {
      "type": "string",
      "description": "ID of the driver's registered vehicle"
    },

    "driver_status": {
      "type": "string",
      "description": "Driver account status",
      "enum": [
        "pending",
        "active",
        "suspended",
        "inactive"
      ],
      "default": "pending"
    },

    "availability_status": {
      "type": "string",
      "description": "Driver availability for Treba allocation",
      "enum": [
        "available",
        "unavailable"
      ],
      "default": "available"
    },

    "preferred_routes": {
      "type": "array",
      "description": "Town-to-town corridors the driver is willing to operate",
      "items": {
        "type": "string"
      }
    },

    "rating": {
      "type": "number",
      "description": "Average passenger rating",
      "default": 0
    },

    "rating_count": {
      "type": "number",
      "description": "Number of ratings received",
      "default": 0
    },

    "trips_completed": {
      "type": "number",
      "description": "Number of completed trips",
      "default": 0
    },

    "maximum_trips_per_day": {
      "type": "number",
      "description": "Maximum trips allowed per day",
      "default": 2
    },

    "minimum_rest_hours": {
      "type": "number",
      "description": "Minimum rest hours used for scheduling",
      "default": 8
    },

    "last_trip_end": {
      "type": "string",
      "description": "Date and time the driver's last trip ended"
    },

    "scheduling_score": {
      "type": "number",
      "description": "Score used by Treba allocation",
      "default": 0
    },

    "fatigue_score": {
      "type": "number",
      "description": "Driver fatigue score",
      "default": 0
    },

    "fairness_score": {
      "type": "number",
      "description": "Driver fairness score used in allocation",
      "default": 0
    }
  },

  "required": [
    "user_id",
    "full_name",
    "phone",
    "driver_status",
    "availability_status"
  ]
}