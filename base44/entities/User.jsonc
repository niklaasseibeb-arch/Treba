{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "app_role": {
      "type": "string",
      "description": "Treba marketplace role chosen at registration",
      "enum": [
        "passenger",
        "driver"
      ]
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending"
      ],
      "default": "active"
    },
    "profile_completion": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "role"
  ]
}