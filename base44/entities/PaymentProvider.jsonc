{
  "name": "PaymentProvider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name shown to passengers, e.g. 'Visa/Mastercard via Stripe', 'FNB Mobile Wallet'"
    },
    "provider_code": {
      "type": "string",
      "description": "Unique code identifying this provider, e.g. 'stripe', 'fnb_wallet', 'mtn_momo', 'pay2cell'"
    },
    "category": {
      "type": "string",
      "enum": [
        "bank_card",
        "mobile_wallet",
        "pay2cell",
        "other_digital",
        "cash_to_driver"
      ],
      "description": "Payment category. Determines how the gateway layer handles this provider."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "configuration": {
      "type": "object",
      "description": "Provider-agnostic gateway settings (e.g. { uses_stripe: true, secret_name: 'STRIPE_SECRET_KEY' } or a mobile-wallet gateway URL). Never stores PINs, passwords or OTPs."
    },
    "icon_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "provider_code",
    "category"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}