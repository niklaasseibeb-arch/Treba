{
  "name": "Route",
  "type": "object",
  "properties": {
    "route_code": {
      "type": "string"
    },

    "origin_town": {
      "type": "string"
    },

    "destination_town": {
      "type": "string"
    },

    "distance_km": {
      "type": "number"
    },

    "approximate_duration_minutes": {
      "type": "number"
    },

    "standard_pickup_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "standard_drop_off_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "default_timeslots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "is_active": {
      "type": "boolean",
      "default": true
    },

    "route_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },

  "required": [
    "origin_town",
    "destination_town",
    "is_active",
    "route_status"
  ]
}