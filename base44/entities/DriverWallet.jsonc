{
  "name": "DriverWallet",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "Reference to the DriverProfile that owns this wallet"
    },
    "payout_method_type": {
      "type": "string",
      "enum": [
        "bank_account",
        "mobile_wallet",
        "ewallet",
        "other"
      ]
    },
    "provider": {
      "type": "string",
      "description": "Configured payout provider name, e.g. FNB, MTC Mobile Money"
    },
    "account_number": {
      "type": "string",
      "description": "Bank account number or mobile wallet number (never PIN/password)"
    },
    "account_holder_name": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "provider_reference": {
      "type": "string",
      "description": "Secure non-sensitive reference/token returned by the payout gateway. Never stores PIN, password or OTP."
    },
    "current_balance": {
      "type": "number",
      "default": 0
    },
    "pending_earnings": {
      "type": "number",
      "default": 0,
      "description": "Earnings from paid trips not yet released for payout (awaiting trip completion)"
    },
    "available_earnings": {
      "type": "number",
      "default": 0,
      "description": "Released earnings available for the driver to request as a payout"
    },
    "paid_earnings_total": {
      "type": "number",
      "default": 0,
      "description": "Cumulative earnings paid out to the driver (digital payouts + cash settlements)"
    },
    "completed_payouts_total": {
      "type": "number",
      "default": 0,
      "description": "Cumulative completed payout amounts"
    },
    "pending_payout_total": {
      "type": "number",
      "default": 0,
      "description": "Payout requests currently processing"
    },
    "failed_payout_total": {
      "type": "number",
      "default": 0,
      "description": "Cumulative failed payout amounts"
    },
    "reversed_payout_total": {
      "type": "number",
      "default": 0,
      "description": "Cumulative reversed payout amounts"
    },
    "treba_fees_total": {
      "type": "number",
      "default": 0,
      "description": "Cumulative Treba commission/fees applied to earnings"
    },
    "treba_fee_rate": {
      "type": "number",
      "default": 0,
      "description": "Legacy per-wallet fee rate. The active PayoutFeeConfig is the source of truth for the fee model."
    }
  },
  "required": [
    "payout_method_type",
    "provider",
    "account_number",
    "account_holder_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}