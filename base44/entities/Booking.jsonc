{
  "name": "Booking",
  "type": "object",
  "properties": {
    "allocation_id": {
      "type": "string"
    },

    "trip_request_id": {
      "type": "string"
    },

    "passenger_id": {
      "type": "string"
    },

    "passenger_name": {
      "type": "string"
    },

    "booked_by_passenger_id": {
      "type": "string"
    },

    "booked_by_passenger_name": {
      "type": "string"
    },

    "traveller_name": {
      "type": "string"
    },

    "traveller_phone": {
      "type": "string"
    },

    "booking_reference": {
      "type": "string"
    },

  
    "booking_type": {
      "type": "string",
      "enum": [
        "single",
        "group",
        "proxy",
        "recurring"
      ],
      "default": "single"
    },

    "booked_for_someone_else": {
      "type": "boolean",
      "default": false
    },

    "recurring_booking_id": {
      "type": "string"
    },

    "travel_date": {
      "type": "string"
    },

    "departure_time": {
      "type": "string"
    },

    "origin": {
      "type": "string"
    },

    "destination": {
      "type": "string"
    },

    "pickup_location": {
      "type": "string"
    },

    "dropoff_location": {
      "type": "string"
    },

    "driver_id": {
      "type": "string"
    },

    "driver_name": {
      "type": "string"
    },

    "vehicle_id": {
      "type": "string"
    },

    "number_of_seats": {
      "type": "number",
      "default": 1
    },

    "driver_fare": {
      "type": "number",
      "default": 0
    },

    "pickup_charge": {
      "type": "number",
      "default": 0
    },

    "dropoff_charge": {
      "type": "number",
      "default": 0
    },

    "luggage_charge": {
      "type": "number",
      "default": 0
    },

    "total_fare": {
      "type": "number",
      "default": 0
    },

    "payment_method": {
      "type": "string",
      "enum": [
        "direct_to_driver"
      ],
      "default": "direct_to_driver"
    },

    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid_to_driver",
        "confirmed",
        "disputed"
      ],
      "default": "pending"
    },

    "booking_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "cancelled",
        "completed",
        "no_show",
        "driver_no_show"
      ],
      "default": "confirmed"
    },

    "fare_received_by_driver": {
      "type": "boolean",
      "default": false
    },

    "fare_received_at": {
      "type": "string"
    },

    "created_at": {
      "type": "string"
    },

    "updated_at": {
      "type": "string"
    }
  },

  "required": [
    "allocation_id",
    "passenger_id",
    "number_of_seats",
    "travel_date",
    "booking_status"
  ]
}