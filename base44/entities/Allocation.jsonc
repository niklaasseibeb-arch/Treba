{
  "name": "Allocation",
  "type": "object",

  "properties": {
    "trip_request_id": {
      "type": "string"
    },

    "route_id": {
      "type": "string"
    },

    "route_code": {
      "type": "string"
    },

    "origin": {
      "type": "string",
      "description": "Origin town"
    },

    "destination": {
      "type": "string",
      "description": "Destination town"
    },

    "date": {
      "type": "string",
      "format": "date"
    },

    "departure_time": {
      "type": "string"
    },

    "timeslot": {
      "type": "string"
    },

    "driver_id": {
      "type": "string",
      "description": "DriverProfile ID"
    },

    "driver_name": {
      "type": "string"
    },

    "driver_user_id": {
      "type": "string",
      "description": "User ID belonging to the driver"
    },

    "vehicle_id": {
      "type": "string"
    },

    "vehicle_label": {
      "type": "string"
    },

    "total_seats": {
      "type": "number",
      "default": 0
    },

    "booked_seats": {
      "type": "number",
      "default": 0
    },

    "available_seats": {
      "type": "number",
      "default": 0
    },

    "status": {
      "type": "string",
      "enum": [
        "awaiting_confirmation",
        "confirmed",
        "active",
        "full",
        "completed",
        "declined",
        "cancelled",
        "reassigned"
      ],
      "default": "awaiting_confirmation"
    },

    "queue_position": {
      "type": "number",
      "default": 1
    },

    "is_visible_to_passengers": {
      "type": "boolean",
      "default": false
    },

    "passenger_booking_open": {
      "type": "boolean",
      "default": false
    },

    "pickup_location": {
      "type": "string",
      "description": "Default or scheduled pickup location"
    },

    "dropoff_location": {
      "type": "string",
      "description": "Default or scheduled drop-off location"
    },

    "driver_fare": {
      "type": "number",
      "default": 0
    },

    "pickup_charge": {
      "type": "number",
      "default": 0
    },

    "dropoff_charge": {
      "type": "number",
      "default": 0
    },

    "luggage_charge": {
      "type": "number",
      "default": 0
    },

    "total_fare": {
      "type": "number",
      "default": 0
    },

    "fare_status": {
      "type": "string",
      "enum": [
        "pending",
        "offered",
        "agreed"
      ],
      "default": "pending"
    },

    "payment_method": {
      "type": "string",
      "enum": [
        "direct_to_driver"
      ],
      "default": "direct_to_driver"
    },

    "payment_status": {
      "type": "string",
      "enum": [
        "not_due",
        "pending",
        "paid_to_driver",
        "confirmed"
      ],
      "default": "not_due"
    },

    "declined_driver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },

    "replacement_for_allocation_id": {
      "type": "string"
    },

    "replaced_at": {
      "type": "string"
    },

    "created_at": {
      "type": "string"
    },

    "updated_at": {
      "type": "string"
    }
  },

  "required": [
    "route_id",
    "origin",
    "destination",
    "date",
    "departure_time",
    "driver_id",
    "total_seats",
    "available_seats",
    "status"
  ]
}