{
  "name": "Trip",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "Reference to the DriverProfile operating this trip"
    },
    "driver_name": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "departure_time": {
      "type": "string"
    },
    "total_seats": {
      "type": "number"
    },
    "available_seats": {
      "type": "number"
    },
    "fare": {
      "type": "number"
    },
    "trip_status": {
      "type": "string",
      "enum": [
        "scheduled",
        "departed",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    }
  },
  "required": [
    "origin",
    "destination",
    "departure_date",
    "departure_time",
    "fare"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}