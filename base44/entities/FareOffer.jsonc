{
  "name": "FareOffer",
  "type": "object",
  "properties": {
    "trip_request_id": {
      "type": "string",
      "description": "Reference to the TripRequest this offer belongs to"
    },
    "passenger_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string",
      "description": "Reference to the DriverProfile"
    },
    "driver_user_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Offered fare amount. Never estimated or suggested by Treba."
    },
    "currency": {
      "type": "string",
      "default": "NAD"
    },
    "offered_by": {
      "type": "string",
      "enum": [
        "passenger",
        "driver"
      ]
    },
    "offered_by_user_id": {
      "type": "string"
    },
    "offer_status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "countered",
        "declined",
        "superseded"
      ],
      "default": "open"
    },
    "previous_offer_id": {
      "type": "string",
      "description": "Reference to the prior offer this one counters"
    },
    "response": {
      "type": "string",
      "enum": [
        "accept",
        "counter",
        "decline"
      ],
      "description": "Response action taken on this offer by the other party"
    },
    "response_by": {
      "type": "string",
      "enum": [
        "passenger",
        "driver"
      ]
    },
    "response_by_user_id": {
      "type": "string"
    },
    "response_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "trip_request_id",
    "amount",
    "offered_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.passenger_id": "{{user.id}}"
        },
        {
          "data.driver_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}