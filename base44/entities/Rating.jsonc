{
  "name": "Rating",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string"
    },
    "trip_id": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewee_id": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string",
      "enum": [
        "passenger",
        "driver"
      ]
    },
    "rating_score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "reviewee_id",
    "rating_score"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}